[Unit]
Description=Weekly Claude recap on Mondays at 09:00, catching up after suspend/power-off

[Timer]
# Mondays at 09:00 (for the department weekly). Persistent=true records the last
# run, so if 09:00 Monday passed while the laptop was suspended or off, the timer
# fires at the first power-on/resume afterwards instead of skipping the week. The
# service then adds its post-wakeup delay.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
